---
const beliefs = [
  { n: '01', tone: 'teal',  head: 'The founder is the seed.',     body: "If you don't have conviction, no campaign budget will fake it. Everything downstream depends on this." },
  { n: '02', tone: 'rose',  head: 'Marketing IS the experience.', body: 'From first touch to repeat purchase, every moment is the brand. There is no separating them.' },
  { n: '03', tone: 'paper', head: 'Delight compounds for free.',  body: "It's the only channel that does. Everything else rents attention. Rent goes up." },
  { n: '04', tone: 'rose',  head: 'Honesty over guarantees.',     body: "I won't promise leads. I won't run campaigns I don't believe will return on themselves." },
  { n: '05', tone: 'teal',  head: 'Truth over cleverness.',       body: 'The market is exhausted by polish. Specificity, conviction, and plain language win every time.' },
  { n: '06', tone: 'ink',   head: 'Strategy serves growth.',      body: 'Pretty is downstream of profitable. Taste shapes the work; results decide if it stays.' },
];
---

<section class="section bg-bone" id="worldview">
  <div class="wrap">
    <div class="path">
      <span class="num">03</span>
      <span class="label">WORLDVIEW</span>
      <span class="slash">/</span>
      <span>SIX BELIEFS THE WORK BENDS AROUND</span>
    </div>

    <div class="section-h split" data-reveal>
      <h2 class="h2" data-zoom>Read these as a filter. <em>Not a manifesto.</em></h2>
      <div class="head-side">
        <p class="lead">If you can't agree here, you'll hate working with me. Better to know now than three months in.</p>
      </div>
    </div>

    <div class="bento" data-reveal-stagger>
      {beliefs.map((b) => (
        <article class={`tile tile-${b.tone}`} data-zoom>
          <div class="tile-head">
            <span class="tile-n mono">{b.n}/06</span>
            <span class="tile-arr" aria-hidden="true">↗</span>
          </div>
          <h3 class="h3">{b.head}</h3>
          <p>{b.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section-h h2 em { font-style: italic; color: var(--warm); }
  .head-side .lead { max-width: 44ch; }

  .bento {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 2px solid var(--ink);
    border-left: 2px solid var(--ink);
  }
  @media (min-width: 760px) {
    .bento { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1080px) {
    .bento { grid-template-columns: repeat(3, 1fr); }
  }

  .tile {
    position: relative;
    padding: var(--s-12) var(--s-8);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    min-height: 300px;
    border-right: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    transition: transform .25s var(--ease);
  }
  .tile:hover { z-index: 2; }

  .tile-teal  { background: var(--teal);  color: var(--bone); }
  .tile-rose  { background: var(--rose);  color: var(--bone); }
  .tile-tan   { background: var(--tan);   color: var(--bone); }
  .tile-fog   { background: var(--fog);   color: var(--ink);  }
  .tile-ink   { background: var(--ink);   color: var(--bone); }
  .tile-paper { background: var(--bone);  color: var(--ink);  }

  .tile-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .tile-arr {
    font-size: 20px;
    transition: transform .25s var(--ease);
  }
  .tile:hover .tile-arr { transform: translate(5px, -5px); }

  .tile h3 { margin-top: var(--s-3); }
  .tile-paper h3, .tile-fog h3 { color: var(--ink); }

  .tile p {
    font-size: 16px;
    line-height: 1.55;
    margin-top: auto;
    opacity: 0.9;
    max-width: 38ch;
  }
</style>
