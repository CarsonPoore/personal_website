---
---

<section class="section bg-rose" id="wedge">
  <div class="wrap">
    <div class="path">
      <span class="num">05</span>
      <span class="label">THE WEDGE</span>
      <span class="slash">/</span>
      <span>WHAT I WILL NOT BE CONFUSED WITH</span>
    </div>

    <div class="grid">
      <div data-zoom>
        <p class="big">
          I am <span class="strike" data-strike>not</span><br/>
          a logo-and-website shop.
        </p>
      </div>

      <aside class="note" data-slide-r>
        <p>
          Indianapolis has hundreds of freelancers calling themselves brand
          strategists who are designers. <strong>That isn't me.</strong>
        </p>
        <p>
          Design is downstream of clarity. My work is upstream of design. The
          wedge is the <span class="under">thinking</span>, not the deliverable.
        </p>
      </aside>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-12);
  }
  @media (min-width: 980px) {
    .grid { grid-template-columns: 1.5fr 1fr; gap: var(--s-16); align-items: end; }
  }

  .big {
    font-family: var(--f-sans);
    font-weight: 800;
    font-size: clamp(48px, 8vw, 128px);
    line-height: 0.92;
    letter-spacing: -0.04em;
    color: var(--bone);
    max-width: 14ch;
  }
  .big br { display: none; }
  @media (min-width: 720px) { .big br { display: inline; } }
  .big .strike { font-style: italic; }
  .big .strike::after {
    background: var(--ink);
    height: 0.16em;
  }

  .note {
    display: grid;
    gap: var(--s-4);
    border-left: 4px solid var(--bone);
    padding: var(--s-2) 0 var(--s-2) var(--s-6);
    max-width: 52ch;
    align-self: end;
  }
  .note p {
    color: rgba(251, 250, 246, 0.94);
    font-size: clamp(17px, 1.35vw, 20px);
    line-height: 1.55;
  }
  .note p strong { color: var(--bone); font-weight: 700; }
  .under {
    background: var(--bone);
    color: var(--rose-deep);
    padding: 0 10px 2px;
    font-weight: 700;
  }
</style>

<script>
  const strikes = document.querySelectorAll<HTMLElement>('#wedge [data-strike]');
  if (strikes.length) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          (e.target as HTMLElement).classList.add('is-in');
          io.unobserve(e.target);
        }
      }
    }, { threshold: 0.35 });
    strikes.forEach((s) => io.observe(s));
  }
</script>
