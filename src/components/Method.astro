---
const steps = [
  {
    n: '01',
    name: 'Founder conviction',
    body: "We start with what you believe. Not your tagline. The wedge inside your conviction. The thing the market hasn't heard from anyone else.",
  },
  {
    n: '02',
    name: 'Customer fit',
    body: "Who that conviction pulls toward you. Specificity over reach. The wrong customer at scale is expensive friction. Most ad budgets fund exactly that.",
  },
  {
    n: '03',
    name: 'Sharp offer',
    body: "The thing that proves the conviction in market. Named. Packaged. Priced. Pointed hard enough to land without explanation.",
  },
  {
    n: '04',
    name: 'Experience design',
    body: "Every touchpoint, first impression to repeat purchase. Marketing IS the experience. We engineer each moment to do the work. No campaign required.",
  },
  {
    n: '05',
    name: 'Engineered word-of-mouth',
    body: "Delight is the only marketing channel that compounds for free. Everything else rents attention. We design the moments your customers can't help repeating.",
  },
];
---

<section class="method bg-teal" id="method" data-h-scroll data-current="01">
  <div class="track">
    <div class="track-pin">
      <div class="track-head">
        <div class="path">
          <span class="num">02</span>
          <span class="label">METHOD</span>
          <span class="slash">/</span>
          <span>FIVE STEPS / THE ORDER MATTERS</span>
          <span class="ts">SCROLL ↓</span>
        </div>

        <div class="track-head-inner">
          <h2 class="h2" data-zoom>Most agencies start at <span class="swatch ink">step three</span>. That's why nothing sticks.</h2>

          <div class="track-progress">
            <div class="counter">
              <span class="counter-cur" id="method-cur">01</span>
              <span class="counter-sep">/</span>
              <span class="counter-tot">05</span>
            </div>
            <div class="bar"><span class="bar-fill"></span></div>
          </div>
        </div>
      </div>

      <div class="track-row" data-h-track>
        {steps.map((s) => (
          <article class="card" data-h-step>
            <header class="card-head">
              <span class="card-n">{s.n}</span>
              <span class="card-of mono">/05</span>
            </header>
            <h3 class="card-title">{s.name}</h3>
            <p class="card-body">{s.body}</p>
          </article>
        ))}
      </div>
    </div>
  </div>

  <div class="method-fallback">
    <ol>
      {steps.map((s) => (
        <li class="step-fb">
          <div class="step-fb-n">
            <span class="n">{s.n}</span>
            <span class="of mono">/05</span>
          </div>
          <div class="step-fb-body">
            <h3 class="h3">{s.name}</h3>
            <p>{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .method {
    color: var(--bone);
    border-bottom: 4px solid var(--ink);
    padding: 0;
    overflow: visible;
    position: relative;
  }

  /* desktop horizontal scroll */
  @media (min-width: 1000px) {
    .method { height: 500vh; }
    .track {
      position: relative;
      height: 100%;
    }
    .track-pin {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .method-fallback { display: none; }
  }

  /* mobile vertical fallback. show the static list only. */
  @media (max-width: 999.98px) {
    .track { display: none; }
    .method { padding: var(--s-20) 0; }
  }

  .track-head {
    padding: var(--s-12) var(--gutter) var(--s-8);
    border-bottom: 2px solid var(--bone);
    flex-shrink: 0;
  }
  .track-head .path {
    color: var(--bone);
    border-bottom-color: var(--bone);
    margin-bottom: var(--s-8);
  }
  .track-head .path .num { background: var(--bone); color: var(--ink); }
  .track-head .path .ts { opacity: 0.7; }

  .track-head-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-6);
    max-width: var(--max);
    margin: 0 auto;
  }
  @media (min-width: 1100px) {
    .track-head-inner {
      grid-template-columns: 1.6fr auto;
      gap: var(--s-12);
      align-items: end;
    }
  }
  .track-head-inner .h2 { color: var(--bone); max-width: 22ch; }
  .track-head-inner .h2 .swatch.ink { background: var(--ink); color: var(--bone); font-style: italic; }

  .track-progress {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    min-width: 220px;
  }
  .counter {
    font-family: var(--f-sans);
    font-weight: 800;
    display: inline-flex;
    align-items: baseline;
    gap: var(--s-2);
  }
  .counter-cur {
    font-size: 64px;
    letter-spacing: -0.04em;
    line-height: 0.85;
    color: var(--bone);
  }
  .counter-sep, .counter-tot {
    font-size: 22px;
    color: rgba(251, 250, 246, 0.6);
  }
  .bar {
    height: 4px;
    background: rgba(251, 250, 246, 0.22);
    width: 100%;
    overflow: hidden;
  }
  .bar-fill {
    display: block;
    height: 100%;
    width: calc(var(--h-progress, 0) * 100%);
    background: var(--bone);
  }

  .track-row {
    display: flex;
    align-items: stretch;
    gap: 0;
    flex: 1 1 auto;
    min-height: 0;
    will-change: transform;
  }

  .card {
    flex-shrink: 0;
    width: clamp(440px, 48vw, 680px);
    padding: var(--s-12);
    border-right: 2px solid var(--bone);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: var(--s-8);
    position: relative;
    height: 100%;
  }
  .card:nth-child(odd)  { background: var(--teal); }
  .card:nth-child(even) { background: var(--teal-deep); }

  .card-head {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    font-family: var(--f-sans);
    font-weight: 800;
  }
  .card-n {
    font-size: clamp(72px, 9vw, 144px);
    letter-spacing: -0.04em;
    line-height: 0.85;
    color: var(--bone);
  }
  .card-of {
    font-size: 14px;
    letter-spacing: 0.14em;
    color: rgba(251, 250, 246, 0.6);
    text-transform: uppercase;
    font-weight: 500;
  }
  .card-title {
    font-family: var(--f-sans);
    font-weight: 700;
    font-size: clamp(28px, 2.8vw, 40px);
    letter-spacing: -0.025em;
    line-height: 1.0;
    color: var(--bone);
  }
  .card-body {
    font-size: clamp(17px, 1.3vw, 20px);
    line-height: 1.55;
    color: rgba(251, 250, 246, 0.88);
    max-width: 44ch;
  }

  /* mobile fallback list */
  .method-fallback ol { list-style: none; padding: 0 var(--gutter); margin: 0; }
  .step-fb {
    padding: var(--s-8) 0;
    border-bottom: 1px solid rgba(251, 250, 246, 0.32);
    display: grid;
    gap: var(--s-3);
  }
  .step-fb-n {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    font-weight: 800;
  }
  .step-fb-n .n {
    font-size: 64px;
    letter-spacing: -0.04em;
    color: var(--bone);
    line-height: 0.85;
  }
  .step-fb-n .of { font-size: 13px; letter-spacing: 0.14em; color: rgba(251, 250, 246, 0.6); text-transform: uppercase; }
  .step-fb-body h3 { color: var(--bone); }
  .step-fb-body p {
    color: rgba(251, 250, 246, 0.82);
    font-size: 17px;
    line-height: 1.55;
    max-width: 60ch;
  }
</style>

<script>
  // Update the counter as horizontal scroll progresses.
  const section = document.getElementById('method');
  const cur = document.getElementById('method-cur');
  if (section && cur) {
    const update = () => {
      const c = (section as HTMLElement).dataset.current;
      if (c && cur.textContent !== c) cur.textContent = c;
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
